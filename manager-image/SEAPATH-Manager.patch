diff --git a/Dockerfile b/Dockerfile
index 983bad0..99168fa 100644
--- a/Dockerfile
+++ b/Dockerfile
@@ -28,12 +28,15 @@ ENV PATH="/opt/seapath/ansible-core-2.16/bin:${PATH}"
 # et `any_errors_fatal = True` fait tomber le déploiement entier).
 #
 # Pour suivre l'upstream : rebuild avec --build-arg SEAPATH_ANSIBLE_REF=<branche>.
+# La branche nomme le dépôt aplati servi à Semaphore ; le commit source reste
+# explicitement épinglé pour rendre l'image reproductible.
 # `vm_pinning_profile`, utilisé par les inventaires, n'existe que sur seapathalloc.
 ARG SEAPATH_ANSIBLE_REPO=https://github.com/seapath/ansible.git
 ARG SEAPATH_ANSIBLE_REF=seapathalloc
-RUN git clone -q --branch "$SEAPATH_ANSIBLE_REF" "$SEAPATH_ANSIBLE_REPO" \
-        /opt/seapath-ansible && \
+ARG SEAPATH_ANSIBLE_COMMIT=526637f39eb5f17ff76b452425842ea85bf25d45
+RUN git clone -q "$SEAPATH_ANSIBLE_REPO" /opt/seapath-ansible && \
     cd /opt/seapath-ansible && \
+    git checkout -q --detach "$SEAPATH_ANSIBLE_COMMIT" && \
     SEAPATH_SHA="$(git rev-parse HEAD)" && \
     ./prepare.sh && \
     # Collections SEAPATH aussi dans le chemin système : les tâches « Init »
